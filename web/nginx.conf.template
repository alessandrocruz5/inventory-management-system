server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # One origin: the Secure, SameSite=Strict auth cookie (spec §8) needs the browser to see no cross-site hop.
    location /api/ {
        proxy_pass ${services__api__http__0};
        # nginx proxies over HTTP/1.0 by default; Envoy (Container Apps ingress) answers that with 426.
        proxy_http_version 1.1;
        # The upstream routes by Host (Container Apps); a cold api plus a paused database can exceed the 60 s default.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA deep links (/stock, /admin/ledger, ...) fall back to the shell.
    location / {
        try_files $uri /index.html;
    }
}
