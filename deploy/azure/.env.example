# Copy to deploy/azure/.env (git-ignored through .gitignore's .env rule) and fill the passwords. See README "## Azure".
# deploy/azure/deploy.sh reads it; never commit real values.

# Resource group the deployment goes into (created if missing)
AZ_RESOURCE_GROUP=ims-demo

# Azure region
AZ_LOCATION=southeastasia

# GitHub user or org that owns the GHCR images, lower-case (ghcr.io/<owner>/inventory-api, inventory-web)
IMAGE_OWNER=

# Image tag; blank means the git short SHA (12 characters)
IMAGE_TAG=

# Azure SQL server admin login, used only by the migrate job.
# Azure SQL reserves sa, admin, administrator, root, guest and public.
SQL_ADMIN_LOGIN=ims_admin

# Azure SQL server admin password.
# Letters and digits only (it sits inside a connection string), 24-128 characters, with an upper, a lower and a digit;
# it must not contain three or more consecutive characters of the login name (SQL's password policy).
# Generate: echo "Pw$(openssl rand -hex 16)Z9"
SQL_ADMIN_PASSWORD=

# Password of the contained user inventory_app (api and seed connect as it; migrate creates it).
# Letters and digits only (it sits inside a connection string), 24-128 characters, with an upper, a lower and a digit;
# it must not contain three or more consecutive characters of "inventory_app" (so no "inv" or "app", in any case).
# Generate: echo "Pw$(openssl rand -hex 16)Z9"
INVENTORY_APP_PASSWORD=

# Password of the seeded sign-in users.
# Needs an upper, a lower, a digit and a symbol, at least 12 characters (Identity's policy). The e2e suite signs in with it.
# Generate: echo "Seed!$(openssl rand -hex 12)A9"
SEED_PASSWORD=
