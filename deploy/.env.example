# Copy to .env (git-ignored) and fill the passwords. Generated by aspire publish; see README "Docker Compose".
# Container image name for api
API_IMAGE=api:latest

# Default container port for api
API_PORT=8080

# Parameter inventory-app-password
# Letters and digits only (it sits inside a connection string), at most 128 characters; SQL CHECK_POLICY applies.
# Generate: echo "App$(openssl rand -hex 16)Z9"
INVENTORY_APP_PASSWORD=

# Container image name for migrate
MIGRATE_IMAGE=migrate:latest

# Container image name for seed
SEED_IMAGE=seed:latest

# Parameter seed-password
# Needs an upper, a lower, a digit and a symbol, at least 6 characters (Identity's default policy). The e2e suite signs in with it.
# Generate: echo "Seed!$(openssl rand -hex 12)A9"
SEED_PASSWORD=

# Parameter sql-password
# SQL Server complexity: at least 8 characters, three of upper, lower, digit and symbol.
# Generate: echo "Sa1$(openssl rand -hex 16)Z"
SQL_PASSWORD=

# Container image name for web
WEB_IMAGE=web:latest
